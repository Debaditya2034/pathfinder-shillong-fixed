rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile (during signup)
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt'])
        && request.resource.data.role in ['tourist', 'driver'];
      
      // Users can update their own profile, but cannot change role after creation
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      // No delete allowed
      allow delete: if false;
    }
    
    // Driver profiles collection
    match /driverProfiles/{driverId} {
      // Drivers can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == driverId;
      
      // Drivers can create their own profile (during signup)
      allow create: if isAuthenticated()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasAll(['uid', 'placesServed'])
        && request.resource.data.uid == driverId;
      
      // Drivers can update their own profile (e.g., placesServed)
      allow update: if isOwner(driverId)
        && request.resource.data.uid == driverId;
      
      // No delete allowed
      allow delete: if false;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      // Tourists can read their own bookings
      // Drivers can read bookings assigned to them
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.driverId != null && resource.data.driverId == request.auth.uid)
      );
      
      // Tourists can create bookings for themselves
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'places', 'scheduledAt', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.driverId == null;
      
      // Drivers can update status for bookings assigned to them
      // Tourists can cancel their own bookings
      allow update: if isAuthenticated() && (
        // Driver updating assigned booking status
        (resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['assigned', 'completed', 'cancelled']
          && resource.data.status == 'assigned') ||
        // Tourist canceling their own booking
        (resource.data.userId == request.auth.uid
          && request.resource.data.status == 'cancelled'
          && resource.data.status == 'pending')
      );
      
      // System/Cloud Function can update driverId and status for assignment
      // Note: This requires a Cloud Function with admin SDK, or we can allow
      // a specific update pattern. For MVP, we'll allow drivers to be assigned
      // through a transaction pattern (client-side with strict rules)
      // In production, use Cloud Functions for assignment
      
      // No delete allowed
      allow delete: if false;
    }
  }
}
